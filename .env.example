# Copy to .env and fill in. .env is gitignored.

# PDF extraction engine:
#   local = free built-in parser for Hyperpure PO PDFs (default, no API key needed)
#   llama = LlamaCloud Extract v2 (needs LLAMA_API_KEY below and paid/free credits)
EXTRACTION_ENGINE=local

# --- Only needed when EXTRACTION_ENGINE=llama ---
# LlamaCloud API key. Create/rotate at https://cloud.llamaindex.ai/ under API Keys.
LLAMA_API_KEY=

# Saved Extract v2 configuration built from EXTRACT_DATA_SCHEMA in app.py.
# Leave unset to use the default in app.py; set to an empty value to send the inline schema instead.
LLAMA_EXTRACT_CONFIG_ID=cfg-ezk14ea1egxpsyy7p15yrzvd4pjq
